<%- include('../layouts/header') %>

<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Directorio de Personas Registradas</h1>
    <p class="text-xs text-slate-500 mt-1">
      <span class="inline-flex items-center text-emerald-600 font-semibold mr-1.5">
        <svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"></path></svg>
        Cifrado AES-256 Descifrado Seguro para Administrador:
      </span>
      Cédula, teléfono y correo electrónico protegidos en base de datos.
    </p>
  </div>
  
  <div class="flex items-center space-x-3">
    <a href="/personas/nuevo" class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      <span>Registrar Persona</span>
    </a>
  </div>
</div>

<!-- Filtros y Búsqueda -->
<div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs mb-6">
  <form action="/personas" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
    <!-- Buscar por texto -->
    <div class="lg:col-span-2">
      <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Buscar por término</label>
      <div class="relative">
        <input 
          type="text" 
          name="search" 
          value="<%= filters.search || '' %>" 
          placeholder="Nombre, cédula, teléfono o correo..." 
          class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
    </div>

    <!-- Filtrar por Sector -->
    <div>
      <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Sector</label>
      <select name="sector" class="w-full py-2 px-3 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todos los sectores</option>
        <% sectoresUnicos.forEach(function(sec) { %>
          <option value="<%= sec %>" <%= filters.sector === sec ? 'selected' : '' %>><%= sec %></option>
        <% }); %>
      </select>
    </div>

    <!-- Filtrar por Sexo -->
    <div>
      <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Sexo</label>
      <select name="sexo" class="w-full py-2 px-3 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todos</option>
        <option value="M" <%= filters.sexo === 'M' ? 'selected' : '' %>>Masculino (M)</option>
        <option value="F" <%= filters.sexo === 'F' ? 'selected' : '' %>>Femenino (F)</option>
        <option value="Otro" <%= filters.sexo === 'Otro' ? 'selected' : '' %>>Otro</option>
      </select>
    </div>

    <!-- Filtrar por Verificación Partido -->
    <div>
      <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Verificación</label>
      <select name="verificado" class="w-full py-2 px-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todas</option>
        <option value="true" <%= filters.verificado === 'true' ? 'selected' : '' %>>Verificados</option>
        <option value="false" <%= filters.verificado === 'false' ? 'selected' : '' %>>No Verificados</option>
      </select>
    </div>

    <!-- Filtrar por Estado / Botones -->
    <div class="flex space-x-2">
      <div class="flex-1">
        <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Estado</label>
        <select name="activo" class="w-full py-2 px-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Todos</option>
          <option value="true" <%= filters.activo === 'true' ? 'selected' : '' %>>Activos</option>
          <option value="false" <%= filters.activo === 'false' ? 'selected' : '' %>>Inactivos</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs rounded-xl shadow-xs transition">
          Filtrar
        </button>
        <% if (filters.search || filters.sector || filters.sexo || filters.activo || filters.verificado) { %>
          <a href="/personas" title="Limpiar Filtros" class="ml-1 p-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </a>
        <% } %>
      </div>
    </div>
  </form>
</div>

<!-- Tabla de Resultados -->
<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
  <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
    <span class="text-xs font-semibold text-slate-600">
      Mostrando <span class="text-indigo-600 font-bold"><%= personas.length %></span> registros encontrados
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-600 uppercase tracking-wider">
          <th class="py-3 px-4">Persona</th>
          <th class="py-3 px-4">Sexo</th>
          <th class="py-3 px-4">Cédula</th>
          <th class="py-3 px-4">Teléfono</th>
          <th class="py-3 px-4">Sector / Dirección</th>
          <th class="py-3 px-4">Correo Electrónico</th>
          <th class="py-3 px-4 text-center">Verificación</th>
          <th class="py-3 px-4 text-center">Estado</th>
          <th class="py-3 px-4 text-center">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (personas.length === 0) { %>
          <tr>
            <td colspan="9" class="py-12 text-center text-slate-400">
              <svg class="w-12 h-12 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
              No se encontraron registros con los filtros seleccionados.
            </td>
          </tr>
        <% } else { %>
          <% personas.forEach(function(p) { %>
            <tr class="hover:bg-indigo-50/30 transition">
              <!-- Nombre y Apellido -->
              <td class="py-3 px-4">
                <div class="font-bold text-slate-900 text-sm"><%= p.nombre %> <%= p.apellido %></div>
                <div class="text-[10px] text-slate-400">ID: <%= p.id.substring(0, 8) %>...</div>
              </td>

              <!-- Sexo -->
              <td class="py-3 px-4">
                <% if (p.sexo === 'M') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-semibold text-[10px]">M</span>
                <% } else if (p.sexo === 'F') { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 font-semibold text-[10px]">F</span>
                <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-semibold text-[10px]">Otro</span>
                <% } %>
              </td>

              <!-- Cédula (Descifrada para el Administrador) -->
              <td class="py-3 px-4 font-mono font-medium text-slate-700">
                <span title="Dato descifrado en memoria para el administrador"><%= p.cedula %></span>
              </td>

              <!-- Teléfono -->
              <td class="py-3 px-4 font-mono text-slate-700">
                <%= p.telefono %>
              </td>

              <!-- Sector y Dirección -->
              <td class="py-3 px-4 max-w-xs">
                <div class="font-semibold text-slate-800 truncate"><%= p.sector %></div>
                <div class="text-[11px] text-slate-400 truncate" title="<%= p.direccion %>"><%= p.direccion %></div>
                <% if (p.colegio_electoral) { %>
                  <div class="text-[10px] text-indigo-600 font-medium truncate mt-0.5 flex items-center" title="Colegio Electoral: <%= p.colegio_electoral %>">
                    <svg class="w-3 h-3 mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    <span><%= p.colegio_electoral %></span>
                  </div>
                <% } %>
              </td>

              <!-- Correo Electrónico -->
              <td class="py-3 px-4 text-slate-700">
                <% if (p.email) { %>
                  <a href="mailto:<%= p.email %>" class="hover:text-indigo-600 transition"><%= p.email %></a>
                <% } else { %>
                  <span class="text-slate-400 italic text-[11px]">No registrado</span>
                <% } %>
              </td>

              <!-- Verificación en el Partido -->
              <td class="py-3 px-4 text-center whitespace-nowrap">
                <% if (p.verificado_partido) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <svg class="w-3 h-3 mr-1 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                    Verificado
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                    <svg class="w-3 h-3 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    No Verificado
                  </span>
                <% } %>
              </td>

              <!-- Estado Activo/Inactivo -->
              <td class="py-3 px-4 text-center">
                <% if (p.activo) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Activo
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-100 text-rose-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span> Inactivo
                  </span>
                <% } %>
              </td>

              <!-- Botones de Acciones: Detalle, Editar, Inactivar/Activar -->
              <td class="py-3 px-4 text-center">
                <div class="inline-flex items-center space-x-1.5">
                  <!-- Botón 1: Visualizar Detalle -->
                  <a 
                    href="/personas/<%= p.id %>" 
                    title="Visualizar Detalle Completo"
                    class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                  </a>

                  <!-- Botón 2: Editar -->
                  <a 
                    href="/personas/<%= p.id %>/editar" 
                    title="Editar Registro"
                    class="p-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                  </a>

                  <!-- Botón 3: Inactivar / Activar -->
                  <form action="/personas/<%= p.id %>/toggle" method="POST" class="inline" onsubmit="return confirm('¿Está seguro de cambiar el estado de <%= p.nombre %> <%= p.apellido %>?')">
                    <% if (p.activo) { %>
                      <button 
                        type="submit" 
                        title="Inactivar Persona"
                        class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 transition"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                      </button>
                    <% } else { %>
                      <button 
                        type="submit" 
                        title="Activar Persona"
                        class="p-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 transition"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                      </button>
                    <% } %>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>
