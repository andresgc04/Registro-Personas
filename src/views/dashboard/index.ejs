<%- include('../layouts/header') %>

  <!-- Banner Superior con Acciones Rápidas -->
  <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Dashboard de Métricas & KPIs</h1>
      <p class="text-sm text-slate-500 mt-1">Seguimiento demográfico y control de registros de ciudadanos.</p>
    </div>
    <div class="flex items-center space-x-3">
      <!-- Botón Copiar Link Público -->
      <button type="button" onclick="copiarLinkPublico()" id="btn-copiar-link"
        title="Copiar enlace para compartir formulario de registro público"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 font-semibold text-xs shadow-xs transition">
        <span id="icon-copiar-link" class="flex items-center">
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z">
            </path>
          </svg>
        </span>
        <span id="text-copiar-link">Copiar Link Público</span>
      </button>

      <!-- Botón Registrar Persona -->
      <a href="/personas/nuevo"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Nuevo Registro</span>
      </a>
    </div>
  </div>

  <!-- Tarjetas de Métricas / KPIs Principales -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Total Registradas -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Personas</p>
        <h3 class="text-3xl font-extrabold text-slate-900 mt-1">
          <%= kpis.total %>
        </h3>
        <p class="text-xs text-slate-500 mt-1 flex items-center">
          <span class="w-2 h-2 rounded-full bg-indigo-500 mr-1.5"></span> Base registrada
        </p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
          </path>
        </svg>
      </div>
    </div>

    <!-- Personas Activas -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Personas Activas</p>
        <h3 class="text-3xl font-extrabold text-emerald-600 mt-1">
          <%= kpis.activos %>
        </h3>
        <p class="text-xs text-slate-500 mt-1">
          <%= kpis.total> 0 ? Math.round((kpis.activos / kpis.total) * 100) : 0 %>% del total
        </p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    </div>

    <!-- Personas Inactivas -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Inactivas</p>
        <h3 class="text-3xl font-extrabold text-rose-600 mt-1">
          <%= kpis.inactivos %>
        </h3>
        <p class="text-xs text-slate-500 mt-1">
          <%= kpis.total> 0 ? Math.round((kpis.inactivos / kpis.total) * 100) : 0 %>% del total
        </p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
        </svg>
      </div>
    </div>

    <!-- Sectores Alcanzados -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Sectores Cubiertos</p>
        <h3 class="text-3xl font-extrabold text-indigo-600 mt-1">
          <%= kpis.porSector.length %>
        </h3>
        <p class="text-xs text-slate-500 mt-1">Comunidades activas</p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z">
          </path>
        </svg>
      </div>
    </div>
  </div>

  <!-- Gráficos de KPIs: Segmentada por Sexo y Segmentada por Sector -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Gráfico de Segmentación por Sexo -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base font-bold text-slate-900">Segmentación por Sexo</h2>
          <p class="text-xs text-slate-500">Distribución de registros por género</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 font-semibold">KPI Demográfico</span>
      </div>
      <div class="h-64 flex items-center justify-center">
        <% if (kpis.total===0) { %>
          <p class="text-sm text-slate-400 italic">No hay registros suficientes para graficar.</p>
          <% } else { %>
            <canvas id="chartSexo"></canvas>
            <% } %>
      </div>
      <div class="mt-4 pt-4 border-t border-slate-100 grid grid-cols-3 text-center text-xs">
        <div>
          <span class="inline-block w-3 h-3 rounded-full bg-indigo-500 mr-1 align-middle"></span>
          <span class="text-slate-600 font-medium">Hombres:</span>
          <strong class="text-slate-900 ml-1">
            <%= kpis.porSexo.M %>
          </strong>
        </div>
        <div>
          <span class="inline-block w-3 h-3 rounded-full bg-rose-400 mr-1 align-middle"></span>
          <span class="text-slate-600 font-medium">Mujeres:</span>
          <strong class="text-slate-900 ml-1">
            <%= kpis.porSexo.F %>
          </strong>
        </div>
        <div>
          <span class="inline-block w-3 h-3 rounded-full bg-amber-400 mr-1 align-middle"></span>
          <span class="text-slate-600 font-medium">Otro:</span>
          <strong class="text-slate-900 ml-1">
            <%= kpis.porSexo.Otro %>
          </strong>
        </div>
      </div>
    </div>

    <!-- Gráfico de Segmentación por Sector -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base font-bold text-slate-900">Segmentación por Sector</h2>
          <p class="text-xs text-slate-500">Top sectores con mayor concentración de registros</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 font-semibold">KPI Geográfico</span>
      </div>
      <div class="h-64 flex items-center justify-center">
        <% if (kpis.porSector.length===0) { %>
          <p class="text-sm text-slate-400 italic">No hay sectores registrados aún.</p>
          <% } else { %>
            <canvas id="chartSector"></canvas>
            <% } %>
      </div>
    </div>
  </div>

  <!-- Últimos Registros Realizados -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-slate-900">Registros Recientes</h2>
        <p class="text-xs text-slate-500">Últimas personas añadidas a la plataforma</p>
      </div>
      <a href="/personas" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition">
        Ver todos los registros &rarr;
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr
            class="border-b border-slate-100 bg-slate-50/75 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
            <th class="py-3 px-5">Nombre Completo</th>
            <th class="py-3 px-5">Sexo</th>
            <th class="py-3 px-5">Sector</th>
            <th class="py-3 px-5">Cédula (Descifrada)</th>
            <th class="py-3 px-5">Estado</th>
            <th class="py-3 px-5 text-right">Acción</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-xs">
          <% if (kpis.ultimosRegistros.length===0) { %>
            <tr>
              <td colspan="6" class="py-8 text-center text-slate-400">
                No hay personas registradas todavía. <a href="/personas/nuevo"
                  class="text-indigo-600 underline font-semibold">Registrar la primera</a>.
              </td>
            </tr>
            <% } else { %>
              <% kpis.ultimosRegistros.forEach(function(p) { %>
                <tr class="hover:bg-slate-50/75 transition">
                  <td class="py-3.5 px-5 font-semibold text-slate-800">
                    <%= p.nombre %>
                      <%= p.apellido %>
                  </td>
                  <td class="py-3.5 px-5 text-slate-600">
                    <% if (p.sexo==='M' ) { %>
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 font-medium">Masculino</span>
                      <% } else if (p.sexo==='F' ) { %>
                        <span
                          class="inline-flex items-center px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 font-medium">Femenino</span>
                        <% } else { %>
                          <span
                            class="inline-flex items-center px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium">Otro</span>
                          <% } %>
                  </td>
                  <td class="py-3.5 px-5 text-slate-600 font-medium">
                    <%= p.sector %>
                  </td>
                  <td class="py-3.5 px-5 font-mono text-slate-700 font-semibold">
                    <%= p.cedula %>
                  </td>
                  <td class="py-3.5 px-5">
                    <% if (p.activo) { %>
                      <span
                        class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Activo
                      </span>
                      <% } else { %>
                        <span
                          class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-600">
                          <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5"></span> Inactivo
                        </span>
                        <% } %>
                  </td>
                  <td class="py-3.5 px-5 text-right">
                    <a href="/personas/<%= p.id %>"
                      class="inline-flex items-center px-2.5 py-1 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 font-semibold transition">
                      Ver Detalle
                    </a>
                  </td>
                </tr>
                <% }); %>
                  <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Script Aislado: Copiar Link de Registro Público -->
  <script>
    async function copiarLinkPublico(event) {
      if (event && event.preventDefault) event.preventDefault();
      
      const url = window.location.origin
        ? (window.location.origin + '/registro')
        : (window.location.protocol + '//' + window.location.host + '/registro');

      const btn = document.getElementById('btn-copiar-link');
      const btnText = document.getElementById('text-copiar-link');
      const iconContainer = document.getElementById('icon-copiar-link');

      let copiado = false;

      // 1. Intentar con API moderna de Clipboard
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(url);
          copiado = true;
        } catch (e) {
          copiado = false;
        }
      }

      // 2. Fallback infalible con elemento temporal fuera de pantalla
      if (!copiado) {
        try {
          const textarea = document.createElement('textarea');
          textarea.value = url;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.left = '-9999px';
          textarea.style.top = '0';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();
          copiado = document.execCommand('copy');
          document.body.removeChild(textarea);
        } catch (err) {
          copiado = false;
        }
      }

      // 3. Feedback visual
      if (copiado) {
        if (btnText) btnText.innerText = '¡Enlace Copiado!';
        if (btn) {
          btn.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-700');
          btn.classList.remove('bg-white', 'text-slate-700');
        }
        if (iconContainer) {
          iconContainer.innerHTML = '<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
        }

        setTimeout(() => {
          if (btnText) btnText.innerText = 'Copiar Link Público';
          if (btn) {
            btn.classList.remove('bg-emerald-50', 'border-emerald-300', 'text-emerald-700');
            btn.classList.add('bg-white', 'text-slate-700');
          }
          if (iconContainer) {
            iconContainer.innerHTML = '<svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>';
          }
        }, 2500);
      } else {
        prompt('Copia este enlace de registro público (Ctrl+C / Cmd+C):', url);
      }
    }

    // Vinculación por EventListener para máxima compatibilidad
    document.addEventListener('DOMContentLoaded', () => {
      const btnCopiar = document.getElementById('btn-copiar-link');
      if (btnCopiar) {
        btnCopiar.addEventListener('click', copiarLinkPublico);
      }
    });
  </script>

  <!-- Script Aislado: Gráficos de KPIs (Chart.js) -->
  <script>
  <% if (kpis.total > 0) { %>
    // 1. Gráfico Sexo
    const ctxSexo = document.getElementById('chartSexo').getContext('2d');
      new Chart(ctxSexo, {
        type: 'doughnut',
        data: {
          labels: ['Hombres (M)', 'Mujeres (F)', 'Otro'],
          datasets: [{
            data: [<%= kpis.porSexo.M %>, <%= kpis.porSexo.F %>, <%= kpis.porSexo.Otro %>],
            backgroundColor: ['#6366f1', '#fb7185', '#fbbf24'],
            borderWidth: 2,
            borderColor: '#ffffff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' }
          },
          cutout: '65%'
        }
      });

    // 2. Gráfico Sector
    <% 
      const topSectores = (kpis.porSector || []).slice(0, 6);
      const labelsSector = JSON.stringify(topSectores.map(s => s.sector));
      const dataSector = JSON.stringify(topSectores.map(s => s.cantidad));
    %>
    const ctxSector = document.getElementById('chartSector').getContext('2d');
      new Chart(ctxSector, {
        type: 'bar',
        data: {
          labels: <%- labelsSector || '[]' %>,
          datasets: [{
            label: 'Cantidad de personas',
            data: <%- dataSector || '[]' %>,
            backgroundColor: '#4f46e5',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          indexAxis: 'y',
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: {
              beginAtZero: true,
              ticks: { precision: 0 }
            }
          }
        }
      });
  <% } %>
  </script>

  <%- include('../layouts/footer') %>