<%- include('../layouts/header') %>

<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Colegios Electorales</h1>
    <p class="text-xs text-slate-500 mt-1">
      Directorio de recintos de votación, mesas electorales y padrón asignado por sector y municipio.
    </p>
  </div>
  
  <div class="flex items-center space-x-3">
    <a href="/colegios/nuevo" class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-md shadow-indigo-600/20 transition">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
      <span>Registrar Colegio Electoral</span>
    </a>
  </div>
</div>

<!-- Tarjetas de Métricas / KPIs de Colegios -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <!-- Total Colegios -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
    <div>
      <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Colegios</p>
      <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= kpis.total %></h3>
      <p class="text-[10px] text-slate-500 mt-0.5">Recintos registrados</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
    </div>
  </div>

  <!-- Colegios Activos -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
    <div>
      <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Activos</p>
      <h3 class="text-2xl font-extrabold text-emerald-600 mt-0.5"><%= kpis.activos %></h3>
      <p class="text-[10px] text-slate-500 mt-0.5">Habilitados para comicios</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </div>
  </div>

  <!-- Total Mesas -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
    <div>
      <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Mesas Electorales</p>
      <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= kpis.mesas %></h3>
      <p class="text-[10px] text-slate-500 mt-0.5">Mesas en recintos</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
    </div>
  </div>

  <!-- Total Electores Estimados -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
    <div>
      <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Padrón Estimado</p>
      <h3 class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= kpis.electores.toLocaleString('es-DO') %></h3>
      <p class="text-[10px] text-slate-500 mt-0.5">Electores asignados</p>
    </div>
    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
    </div>
  </div>
</div>

<!-- Filtros y Búsqueda -->
<div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs mb-6">
  <form action="/colegios" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
    <!-- Buscar por texto -->
    <div class="lg:col-span-2">
      <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Buscar Recinto / Código</label>
      <div class="relative">
        <input 
          type="text" 
          name="search" 
          value="<%= filters.search || '' %>" 
          placeholder="Código, nombre del recinto, sector..." 
          class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
    </div>

    <!-- Filtrar por Municipio -->
    <div>
      <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Municipio</label>
      <select name="municipio" class="w-full py-2 px-3 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todos los municipios</option>
        <% municipiosUnicos.forEach(function(m) { %>
          <option value="<%= m %>" <%= filters.municipio === m ? 'selected' : '' %>><%= m %></option>
        <% }); %>
      </select>
    </div>

    <!-- Filtrar por Sector -->
    <div>
      <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Sector</label>
      <select name="sector" class="w-full py-2 px-3 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todos los sectores</option>
        <% sectoresUnicos.forEach(function(s) { %>
          <option value="<%= s %>" <%= filters.sector === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </div>

    <!-- Filtrar por Estado / Botones -->
    <div class="flex space-x-2">
      <div class="flex-1">
        <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Estado</label>
        <select name="activo" class="w-full py-2 px-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Todos</option>
          <option value="true" <%= filters.activo === 'true' ? 'selected' : '' %>>Activos</option>
          <option value="false" <%= filters.activo === 'false' ? 'selected' : '' %>>Inactivos</option>
        </select>
      </div>
      <div class="flex items-end">
        <button type="submit" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs rounded-xl shadow-xs transition">
          Filtrar
        </button>
        <% if (filters.search || filters.municipio || filters.sector || filters.activo) { %>
          <a href="/colegios" title="Limpiar Filtros" class="ml-1 p-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </a>
        <% } %>
      </div>
    </div>
  </form>
</div>

<!-- Tabla de Resultados de Colegios -->
<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
  <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
    <span class="text-xs font-semibold text-slate-600">
      Mostrando <span class="text-indigo-600 font-bold"><%= colegios.length %></span> colegios electorales
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-600 uppercase tracking-wider">
          <th class="py-3 px-4">Código</th>
          <th class="py-3 px-4">Recinto Electoral</th>
          <th class="py-3 px-4">Municipio / Sector</th>
          <th class="py-3 px-4">Dirección</th>
          <th class="py-3 px-4 text-center">Mesas</th>
          <th class="py-3 px-4 text-right">Electores</th>
          <th class="py-3 px-4 text-center">Estado</th>
          <th class="py-3 px-4 text-center">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (colegios.length === 0) { %>
          <tr>
            <td colspan="8" class="py-12 text-center text-slate-400">
              <svg class="w-12 h-12 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
              No se encontraron colegios electorales con los filtros indicados.
              <div class="mt-2">
                <a href="/colegios/nuevo" class="text-indigo-600 underline font-semibold">Registrar un nuevo colegio electoral</a>
              </div>
            </td>
          </tr>
        <% } else { %>
          <% colegios.forEach(function(c) { %>
            <tr class="hover:bg-indigo-50/30 transition">
              <!-- Código -->
              <td class="py-3 px-4">
                <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-indigo-50 text-indigo-700 font-mono font-bold text-xs border border-indigo-200/60">
                  <%= c.codigo %>
                </span>
              </td>

              <!-- Nombre del Recinto -->
              <td class="py-3 px-4">
                <div class="font-bold text-slate-900 text-sm"><%= c.nombre %></div>
                <div class="text-[10px] text-slate-400">ID: <%= c.id ? c.id.substring(0, 8) : 'col' %>...</div>
              </td>

              <!-- Municipio y Sector -->
              <td class="py-3 px-4">
                <div class="font-semibold text-slate-800"><%= c.municipio %></div>
                <div class="text-[11px] text-slate-500 font-medium"><%= c.sector %></div>
              </td>

              <!-- Dirección -->
              <td class="py-3 px-4 max-w-xs">
                <div class="text-slate-700 truncate" title="<%= c.direccion %>"><%= c.direccion %></div>
              </td>

              <!-- Mesas -->
              <td class="py-3 px-4 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold text-xs">
                  <%= c.mesas || 1 %>
                </span>
              </td>

              <!-- Electores -->
              <td class="py-3 px-4 text-right font-mono font-medium text-slate-800">
                <%= (c.electores || 0).toLocaleString('es-DO') %>
              </td>

              <!-- Estado -->
              <td class="py-3 px-4 text-center">
                <% if (c.activo) { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Activo
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-100 text-rose-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span> Inactivo
                  </span>
                <% } %>
              </td>

              <!-- Acciones -->
              <td class="py-3 px-4 text-center">
                <form action="/colegios/<%= c.id %>/toggle" method="POST" class="inline" onsubmit="return confirm('¿Confirma cambiar el estado del colegio electoral <%= c.codigo %>?')">
                  <% if (c.activo) { %>
                    <button 
                      type="submit" 
                      title="Inactivar Colegio"
                      class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 transition"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                    </button>
                  <% } else { %>
                    <button 
                      type="submit" 
                      title="Activar Colegio"
                      class="p-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-600 transition"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </button>
                  <% } %>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>

