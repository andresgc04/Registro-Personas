<%- include('../layouts/header') %>

<div class="space-y-6">
  <!-- Encabezado con Título y Botón de Nuevo Usuario -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight flex items-center">
        <svg class="w-7 h-7 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <span>Gestión de Usuarios y Roles</span>
      </h1>
      <p class="text-xs text-slate-500 mt-1">Control de acceso basado en roles (RBAC) y asignación de permisos por módulos</p>
    </div>

    <div>
      <a 
        href="/usuarios/nuevo" 
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md shadow-indigo-600/30 transition transform active:scale-98"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
        <span>Registrar Nuevo Usuario</span>
      </a>
    </div>
  </div>

  <!-- Tarjetas KPIs de Usuarios -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Total Usuarios</p>
        <p class="text-2xl font-black text-slate-900 mt-0.5"><%= kpis.total %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
      </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Activos</p>
        <p class="text-2xl font-black text-emerald-600 mt-0.5"><%= kpis.activos %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Superadministradores</p>
        <p class="text-2xl font-black text-purple-700 mt-0.5"><%= kpis.porRol.superadmin || 0 %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
      </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs flex items-center justify-between">
      <div>
        <p class="text-slate-400 text-[11px] font-semibold uppercase tracking-wider">Operadores / Digitadores</p>
        <p class="text-2xl font-black text-blue-600 mt-0.5"><%= kpis.porRol.operador || 0 %></p>
      </div>
      <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
      </div>
    </div>
  </div>

  <!-- Barra de Búsqueda y Filtros -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-xs">
    <form action="/usuarios" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end">
      <!-- Búsqueda por texto -->
      <div class="lg:col-span-2">
        <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Buscar por nombre o correo</label>
        <div class="relative">
          <input 
            type="text" 
            name="search" 
            value="<%= filters.search || '' %>" 
            placeholder="Escriba para filtrar usuarios..." 
            class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
      </div>

      <!-- Filtrar por Rol -->
      <div>
        <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Rol</label>
        <select name="role" class="w-full py-2 px-3 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Todos los roles</option>
          <% Object.keys(roles).forEach(function(rKey) { %>
            <option value="<%= rKey %>" <%= filters.role === rKey ? 'selected' : '' %>><%= roles[rKey].nombre %></option>
          <% }); %>
        </select>
      </div>

      <!-- Filtrar por Estado / Botones -->
      <div class="flex space-x-2">
        <div class="flex-1">
          <label class="block text-[11px] font-semibold uppercase text-slate-500 mb-1">Estado</label>
          <select name="activo" class="w-full py-2 px-2.5 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="">Todos</option>
            <option value="true" <%= filters.activo === 'true' ? 'selected' : '' %>>Activos</option>
            <option value="false" <%= filters.activo === 'false' ? 'selected' : '' %>>Inactivos</option>
          </select>
        </div>
        <div class="flex items-end">
          <button type="submit" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs rounded-xl shadow-xs transition">
            Filtrar
          </button>
          <% if (filters.search || filters.role || filters.activo) { %>
            <a href="/usuarios" title="Limpiar Filtros" class="ml-1 p-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </a>
          <% } %>
        </div>
      </div>
    </form>
  </div>

  <!-- Tabla de Usuarios Registrados -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
      <span class="text-xs font-semibold text-slate-600">
        Mostrando <span class="text-indigo-600 font-bold"><%= usuarios.length %></span> usuarios
      </span>
      <span class="text-[11px] text-slate-400">
        Control de acceso granular por módulos
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50 text-[11px] font-bold text-slate-600 uppercase tracking-wider">
            <th class="py-3 px-4">Usuario</th>
            <th class="py-3 px-4">Rol Asignado</th>
            <th class="py-3 px-4">Permisos / Módulos Autorizados</th>
            <th class="py-3 px-4 text-center">Estado</th>
            <th class="py-3 px-4">Registro</th>
            <th class="py-3 px-4 text-center">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (usuarios.length === 0) { %>
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                No se encontraron usuarios con los criterios de búsqueda.
              </td>
            </tr>
          <% } else { %>
            <% usuarios.forEach(function(u) { %>
              <% const rolInfo = roles[u.role] || { nombre: u.role, badgeColor: 'bg-slate-100 text-slate-700 border-slate-200' }; %>
              <% const isSelf = currentUser && (currentUser.id === u.id); %>
              <tr class="hover:bg-indigo-50/20 transition">
                <!-- Avatar y Nombre -->
                <td class="py-3 px-4">
                  <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl <%= u.role === 'superadmin' ? 'bg-purple-600' : (u.role === 'admin' ? 'bg-indigo-600' : 'bg-slate-700') %> text-white flex items-center justify-center font-bold text-xs shadow-xs shrink-0">
                      <%= u.nombre.charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <div class="font-bold text-slate-900 flex items-center space-x-1.5">
                        <span><%= u.nombre %></span>
                        <% if (isSelf) { %>
                          <span class="px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700 text-[10px] font-semibold border border-indigo-200">Tú</span>
                        <% } %>
                      </div>
                      <div class="text-[11px] text-slate-400 font-mono"><%= u.email %></div>
                    </div>
                  </div>
                </td>

                <!-- Rol -->
                <td class="py-3 px-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold border <%= rolInfo.badgeColor %>">
                    <%= rolInfo.nombre %>
                  </span>
                </td>

                <!-- Permisos de Módulos -->
                <td class="py-3 px-4 max-w-xs">
                  <% if (u.role === 'superadmin') { %>
                    <span class="inline-flex items-center text-[10px] font-semibold text-purple-700 bg-purple-50 px-2 py-0.5 rounded-md border border-purple-200">
                      ★ Todos los módulos permitidos
                    </span>
                  <% } else { %>
                    <div class="flex flex-wrap gap-1">
                      <% (u.permisos || []).forEach(function(perm) { %>
                        <% const mod = modules.find(m => m.id === perm); %>
                        <span class="text-[10px] font-medium bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded border border-slate-200">
                          <%= mod ? mod.nombre.split(' ')[0] : perm %>
                        </span>
                      <% }); %>
                      <% if (!u.permisos || u.permisos.length === 0) { %>
                        <span class="text-[10px] text-slate-400 italic">Sin permisos específicos</span>
                      <% } %>
                    </div>
                  <% } %>
                </td>

                <!-- Estado Activo/Inactivo -->
                <td class="py-3 px-4 text-center">
                  <% if (u.activo) { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span> Activo
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-100 text-rose-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5"></span> Inactivo
                    </span>
                  <% } %>
                </td>

                <!-- Fecha de Registro -->
                <td class="py-3 px-4 text-slate-500 text-[11px] whitespace-nowrap">
                  <%= new Date(u.created_at).toLocaleDateString('es-DO') %>
                </td>

                <!-- Acciones -->
                <td class="py-3 px-4 text-center whitespace-nowrap">
                  <div class="inline-flex items-center space-x-1.5">
                    <!-- Editar -->
                    <a 
                      href="/usuarios/<%= u.id %>/editar" 
                      title="Editar Usuario y Permisos"
                      class="p-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 transition"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    </a>

                    <!-- Activar / Inactivar -->
                    <% if (!isSelf) { %>
                      <form action="/usuarios/<%= u.id %>/toggle" method="POST" class="inline" onsubmit="return confirm('¿Desea cambiar el estado de este usuario?')">
                        <button 
                          type="submit" 
                          title="<%= u.activo ? 'Desactivar usuario' : 'Activar usuario' %>"
                          class="p-1.5 rounded-lg <%= u.activo ? 'bg-amber-50 hover:bg-amber-100 text-amber-700' : 'bg-emerald-50 hover:bg-emerald-100 text-emerald-700' %> transition"
                        >
                          <% if (u.activo) { %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
                          <% } else { %>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                          <% } %>
                        </button>
                      </form>

                      <!-- Eliminar -->
                      <form action="/usuarios/<%= u.id %>/eliminar" method="POST" class="inline" onsubmit="return confirm('¿Está seguro de que desea eliminar permanentemente este usuario? Esta acción no se puede deshacer.')">
                        <button 
                          type="submit" 
                          title="Eliminar usuario"
                          class="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 transition"
                        >
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

