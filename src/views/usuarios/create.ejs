<%- include('../layouts/header') %>

<div class="max-w-3xl mx-auto space-y-6">
  <!-- Encabezado y Navegación -->
  <div class="flex items-center justify-between">
    <div>
      <div class="flex items-center space-x-2 text-xs text-slate-500 mb-1">
        <a href="/usuarios" class="hover:text-indigo-600 transition">Usuarios</a>
        <span>&rsaquo;</span>
        <span class="text-slate-800 font-semibold">Nuevo Usuario</span>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Registrar Nuevo Usuario</h1>
      <p class="text-xs text-slate-500">Cree una nueva cuenta de acceso y configure sus roles y permisos</p>
    </div>

    <a 
      href="/usuarios" 
      class="px-3.5 py-2 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-semibold text-xs transition"
    >
      &larr; Volver al Listado
    </a>
  </div>

  <!-- Formulario de Registro -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 sm:p-8">
    <form action="/usuarios/nuevo" method="POST" class="space-y-6" novalidate>
      
      <!-- Sección 1: Datos Personales y Credenciales -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 pb-2 border-b border-slate-100 flex items-center">
          <svg class="w-4 h-4 mr-1.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          Información del Usuario y Acceso
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Nombre Completo -->
          <div class="sm:col-span-2">
            <label for="nombre" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              Nombre Completo <span class="text-rose-500">*</span>
            </label>
            <input 
              type="text" 
              name="nombre" 
              id="nombre" 
              required 
              placeholder="Ej: Lic. Roberto Martínez"
              value="<%= oldInput && oldInput.nombre ? oldInput.nombre : '' %>"
              class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
            >
          </div>

          <!-- Correo Electrónico -->
          <div class="sm:col-span-2">
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              Correo Electrónico (Usuario de Login) <span class="text-rose-500">*</span>
            </label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              required 
              placeholder="usuario@partido.org.do"
              value="<%= oldInput && oldInput.email ? oldInput.email : '' %>"
              class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
            >
          </div>

          <!-- Contraseña -->
          <div>
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              Contraseña de Acceso <span class="text-rose-500">*</span>
            </label>
            <input 
              type="password" 
              name="password" 
              id="password" 
              required 
              placeholder="Mínimo 6 caracteres"
              class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
            >
            <p class="text-[10px] text-slate-400 mt-1">Cifrada de forma irreversible con Bcrypt (12 rondas)</p>
          </div>

          <!-- Confirmar Contraseña -->
          <div>
            <label for="confirm_password" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
              Confirmar Contraseña <span class="text-rose-500">*</span>
            </label>
            <input 
              type="password" 
              name="confirm_password" 
              id="confirm_password" 
              required 
              placeholder="Repita la contraseña"
              class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
            >
          </div>
        </div>
      </div>

      <!-- Sección 2: Rol y Permisos de Módulos (RBAC) -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 pb-2 border-b border-slate-100 flex items-center">
          <svg class="w-4 h-4 mr-1.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          Rol y Asignación de Permisos de Módulos
        </h3>

        <!-- Rol Principal -->
        <div class="mb-5">
          <label for="role" class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">
            Rol del Usuario <span class="text-rose-500">*</span>
          </label>
          <select 
            name="role" 
            id="roleSelect" 
            required 
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition bg-white"
          >
            <% Object.keys(roles).forEach(function(rKey) { %>
              <% const r = roles[rKey]; %>
              <option 
                value="<%= rKey %>" 
                <%= (oldInput && oldInput.role === rKey) ? 'selected' : (rKey === 'admin' ? 'selected' : '') %>
              >
                <%= r.nombre %> &mdash; <%= r.descripcion %>
              </option>
            <% }); %>
          </select>
          <p class="text-[11px] text-slate-400 mt-1">Al cambiar el rol se preseleccionan los módulos recomendados automáticamente.</p>
        </div>

        <!-- Checklist de Permisos por Módulos -->
        <div class="bg-slate-50/80 p-4 rounded-2xl border border-slate-200">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-bold text-slate-700">Módulos del Sistema Permitidos</span>
            <span class="text-[10px] text-indigo-600 font-semibold cursor-pointer hover:underline" id="resetPermsBtn">
              Reestablecer a valores del rol
            </span>
          </div>

          <div class="space-y-2.5">
            <% modules.forEach(function(mod) { %>
              <label class="flex items-start p-2.5 rounded-xl border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-50/30">
                <input 
                  type="checkbox" 
                  name="permisos[]" 
                  value="<%= mod.id %>" 
                  class="perm-checkbox w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 mt-0.5"
                >
                <div class="ml-3">
                  <span class="text-xs font-bold text-slate-800"><%= mod.nombre %></span>
                  <p class="text-[11px] text-slate-400"><%= mod.descripcion %></p>
                </div>
              </label>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- Sección 3: Estado Inicial de la Cuenta -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">
          Estado Inicial de la Cuenta <span class="text-rose-500">*</span>
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50">
            <input 
              type="radio" 
              name="activo" 
              value="true" 
              class="w-4 h-4 text-emerald-600 border-slate-300 focus:ring-emerald-500"
              <%= (!oldInput || oldInput.activo === 'true' || oldInput.activo === true) ? 'checked' : '' %>
            >
            <div class="ml-3">
              <span class="text-xs font-bold text-emerald-800">Usuario Activo</span>
              <p class="text-[11px] text-emerald-600">Puede iniciar sesión inmediatamente</p>
            </div>
          </label>

          <label class="flex items-center p-3 rounded-xl border border-slate-200 bg-white cursor-pointer hover:bg-slate-50 transition has-[:checked]:border-slate-400 has-[:checked]:bg-slate-100">
            <input 
              type="radio" 
              name="activo" 
              value="false" 
              class="w-4 h-4 text-slate-600 border-slate-300 focus:ring-slate-500"
              <%= (oldInput && (oldInput.activo === 'false' || oldInput.activo === false)) ? 'checked' : '' %>
            >
            <div class="ml-3">
              <span class="text-xs font-bold text-slate-700">Usuario Inactivo</span>
              <p class="text-[11px] text-slate-400">Acceso bloqueado hasta activación</p>
            </div>
          </label>
        </div>
      </div>

      <!-- Botones de Acción -->
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
        <a 
          href="/usuarios" 
          class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 text-xs font-semibold transition"
        >
          Cancelar
        </a>
        <button 
          type="submit" 
          class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition transform active:scale-98 flex items-center space-x-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span>Guardar Usuario</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  (function() {
    const roleDefaults = {
      superadmin: ['dashboard', 'personas', 'colegios', 'newsletter', 'usuarios'],
      admin: ['dashboard', 'personas', 'colegios', 'newsletter'],
      operador: ['personas', 'colegios'],
      consultor: ['dashboard', 'personas']
    };

    const roleSelect = document.getElementById('roleSelect');
    const permCheckboxes = document.querySelectorAll('.perm-checkbox');
    const resetBtn = document.getElementById('resetPermsBtn');

    function applyRolePermissions(role) {
      const allowed = roleDefaults[role] || ['personas'];
      permCheckboxes.forEach(cb => {
        cb.checked = allowed.includes(cb.value);
      });
    }

    if (roleSelect) {
      roleSelect.addEventListener('change', function() {
        applyRolePermissions(this.value);
      });
      // Inicializar según el valor seleccionado
      applyRolePermissions(roleSelect.value);
    }

    if (resetBtn && roleSelect) {
      resetBtn.addEventListener('click', function() {
        applyRolePermissions(roleSelect.value);
      });
    }
  })();
</script>

<%- include('../layouts/footer') %>

