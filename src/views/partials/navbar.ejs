<header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-xs">
  <div class="px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <!-- Botón móvil para menú lateral -->
      <button type="button" id="mobile-menu-btn" class="lg:hidden text-slate-500 hover:text-slate-700 focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>

      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold shadow-md shadow-indigo-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        </div>
        <span class="font-bold text-lg text-slate-800 tracking-tight hidden sm:inline-block">RegPersonas <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 font-semibold ml-1">OWASP Pro</span></span>
      </div>
    </div>

    <!-- Acciones Rápidas y Usuario -->
    <div class="flex items-center space-x-3 sm:space-x-4">
      <!-- Enlace Público Compartible -->
      <a href="/registro" target="_blank" class="inline-flex items-center space-x-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition shadow-xs">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        <span class="hidden md:inline">Link Público de Registro</span>
      </a>

      <!-- Menú Usuario -->
      <div class="flex items-center space-x-2.5 pl-3 border-l border-slate-200">
        <div class="w-8 h-8 rounded-full <%= (currentUser && currentUser.role === 'superadmin') ? 'bg-purple-700' : 'bg-slate-800' %> text-white flex items-center justify-center font-bold text-xs shadow-xs">
          <%= (currentUser && currentUser.nombre) ? currentUser.nombre.charAt(0).toUpperCase() : 'A' %>
        </div>
        <div class="hidden sm:block text-left text-xs">
          <div class="flex items-center space-x-1.5">
            <p class="font-bold text-slate-800 leading-tight"><%= (currentUser && currentUser.nombre) ? currentUser.nombre : 'Admin' %></p>
            <% if (currentUser && currentUser.role) { %>
              <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold uppercase tracking-wider <%= currentUser.role === 'superadmin' ? 'bg-purple-100 text-purple-700' : (currentUser.role === 'admin' ? 'bg-indigo-100 text-indigo-700' : 'bg-slate-100 text-slate-600') %>">
                <%= currentUser.role %>
              </span>
            <% } %>
          </div>
          <p class="text-slate-400 font-normal text-[11px]"><%= (currentUser && currentUser.email) ? currentUser.email : 'admin@sistema.com' %></p>
        </div>
        <a href="/auth/logout" title="Cerrar Sesión" class="text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition ml-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
        </a>
      </div>
    </div>
  </div>
</header>
