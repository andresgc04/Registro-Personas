<% if (typeof alertMessage !== 'undefined' && alertMessage) { %>
  <% 
    let bgClass = 'bg-blue-50 border-blue-500 text-blue-800';
    let iconClass = 'text-blue-500';
    if (typeof alertType !== 'undefined') {
      if (alertType === 'success') {
        bgClass = 'bg-emerald-50 border-emerald-500 text-emerald-800';
        iconClass = 'text-emerald-500';
      } else if (alertType === 'error') {
        bgClass = 'bg-rose-50 border-rose-500 text-rose-800';
        iconClass = 'text-rose-500';
      } else if (alertType === 'warning') {
        bgClass = 'bg-amber-50 border-amber-500 text-amber-800';
        iconClass = 'text-amber-500';
      }
    }
  %>
  <div class="mb-6 p-4 border-l-4 rounded-r-lg shadow-sm flex items-start justify-between <%= bgClass %> transition-all duration-300" role="alert">
    <div class="flex items-center space-x-3">
      <svg class="w-5 h-5 flex-shrink-0 <%= iconClass %>" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-sm font-medium"><%= alertMessage %></span>
    </div>
    <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 focus:outline-none">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>
<% } %>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="mb-6 p-4 border-l-4 border-rose-500 bg-rose-50 rounded-r-lg shadow-sm">
    <div class="flex items-center mb-2 text-rose-800 font-semibold text-sm">
      <svg class="w-5 h-5 mr-2 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
      </svg>
      Por favor verifique los siguientes campos:
    </div>
    <ul class="list-disc list-inside space-y-1 text-xs text-rose-700 ml-2">
      <% errors.forEach(function(error) { %>
        <li><%= error.msg %></li>
      <% }); %>
    </ul>
  </div>
<% } %>
