  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sistema de Registro de Personas' %> - MVC Pro</title>
  
  <!-- Tailwind CSS (NPM local) -->
  <link rel="stylesheet" href="/css/tailwind.css">

  <!-- Chart.js para gráficos de KPIs (NPM local) -->
