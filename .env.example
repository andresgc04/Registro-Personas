PORT=3000
NODE_ENV=development

# Clave secreta para firma de JSON Web Tokens (JWT)
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_123456!
JWT_EXPIRES_IN=8h

# Claves criptográficas OWASP para Cifrado At-Rest (AES-256-GCM)
# Debe ser una clave hexadecimal de 64 caracteres (32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Clave para Hash HMAC-SHA256 (Blind Index para búsquedas seguras de cédula/email)
HASH_SECRET=secure_blind_index_salt_hmac_secret_2026!

# Credenciales de Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ====================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS (SMTP)
# ====================================================================
# OPCIÓN A: OUTLOOK / HOTMAIL
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@outlook.com
# SMTP_PASS=tu-contraseña
# EMAIL_FROM="Sistema de Registro <tu-correo@outlook.com>"
#
# OPCIÓN B: GMAIL (Contraseña de aplicación de 16 caracteres)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# EMAIL_FROM="Sistema de Registro <tu-correo@gmail.com>"
#
# Modo Simulación por defecto:
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=demo_user@ethereal.email
SMTP_PASS=demo_password
EMAIL_FROM="Sistema de Registro <noreply@registropersonas.com>"

# Credenciales iniciales del Administrador (se auto-inicializan en primer inicio si no existen)
INITIAL_ADMIN_EMAIL=admin@registropersonas.com
INITIAL_ADMIN_PASSWORD=Admin12345!*
